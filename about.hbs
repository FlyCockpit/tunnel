<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Tunnel — third-party licenses</title>
  <style>
    body { font-family: sans-serif; max-width: 70rem; margin: 2rem auto; padding: 0 1rem; }
    pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <h1>Tunnel — third-party licenses</h1>
  <p>Dependency licenses and the crates using each license in the release target set.</p>
  {{#each licenses}}
  <section>
    <h2>{{name}}</h2>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
